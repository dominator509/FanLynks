{
  "name": "custom-link-hub-v5-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "vite": "^8.0.16",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18"
  },
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-date=2026-04-07",
    "deploy": "wrangler pages deploy public",
    "typecheck": "tsc --noEmit",
    "seed:generate": "node scripts/generate-dev-seed.mjs",
    "seed:show": "node scripts/generate-dev-seed.mjs --stdout",
    "hash:password": "node scripts/generate-password-hash.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy:check": "node scripts/check-deploy-ready.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  }
}
